# Telegram Bot API (обязательно). Создайте бота у @BotFather.
BOT_TOKEN=

# Закрытое тестирование (опционально): числовые Telegram user id через запятую, пробел или ;.
# Не задано или пусто — доступ для всех.
# Пример для двух аккаунтов: ALLOWED_TELEGRAM_USER_IDS=123456789,987654321
# Узнать id: @userinfobot / @RawDataBot; подробности — docs/DEPLOY.md.

# Где хранить последнюю дату «карты дня» по пользователям (лимит 1× за календарные сутки по дате в часовом поясе ниже).
# По умолчанию: ./data/day-draw-state.json (рядом с рабочей директорией процесса).
# DAY_DRAW_STATE_PATH=

# IANA-часовой пояс для границы «суток» лимита «карта дня» (по умолчанию Europe/Moscow).
# DAY_DRAW_TIMEZONE=Europe/Moscow

# Cloudflare Workers AI (обязательно для толкований через ИИ).
# CLOUDFLARE_ACCOUNT_ID — 32 hex-символа из дашборда Cloudflare (Overview → Account ID).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Необязательно: модель по умолчанию в коде — @cf/meta/llama-3.1-8b-instruct
# CLOUDFLARE_AI_MODEL=
