# Скопируйте в .env и заполните. Подробности — docs/DEPLOY.md и docs/README.md.
#
# Telegram Bot API (обязательно). Создайте бота у @BotFather.
BOT_TOKEN=

# SQLite (обязательно для 2.x): путь к файлу БД. По умолчанию ./data/vodovorot.db
# DATABASE_PATH=

# Legacy: JSON слотов «карта дня» из 1.x — один раз импортируется в БД при старте, если таблица слотов пуста.
# DAY_DRAW_STATE_PATH=

# IANA-часовой пояс для границы «суток» лимита «карта дня» и для расчёта времени подписки (по умолчанию Europe/Moscow, UTC+3).
# DAY_DRAW_TIMEZONE=Europe/Moscow

# Локальное время ежедневной автокарты (ЧЧ:ММ, 00:00–23:59) до первого выбора пользователем; неверное значение — как 09:00.
# DAY_PUSH_DEFAULT_HHMM=09:00

# Автоматическая рассылка «На день» подписчикам. Без 1/true/yes — выкл; подписки в БД сохраняются.
DAY_PUSH_ENABLED=1

# Админы (полный доступ + /admin, создание промокодов): user id через запятую, пробел или ;.
# ADMIN_TELEGRAM_USER_IDS=123456789

# OpenRouter Chat Completions (обязательно для толкований через ИИ).
# Ключ: https://openrouter.ai/keys — в проде только в .env на сервере, не в git.
OPENROUTER_API_KEY=
# Цепочка бесплатных моделей (:free) задана в src/openRouterModels.ts (последовательный fallback).

# Mini App «Настройки» — HTTPS на том же Droplet (Caddy в compose, profile `webapp`).
# Вариант без своего домена: WEBAPP_DOMAIN=<IP-с-дефисами>.sslip.io (см. docs/DEPLOY.md).
WEBAPP_DOMAIN=
ACME_EMAIL=
# WEBAPP_PUBLIC_URL=https://your-domain.example/webapp
# WEBAPP_PATH=/webapp
# WEBAPP_PORT=8080
# WEBAPP_PRIVACY_URL=https://your-domain.example/webapp/privacy.html
