# Telegram Bot API (обязательно). Создайте бота у @BotFather.
BOT_TOKEN=

# Закрытое тестирование (опционально): числовые Telegram user id через запятую, пробел или ;.
# Не задано или пусто — доступ для всех.
# Пример для двух аккаунтов: ALLOWED_TELEGRAM_USER_IDS=123456789,987654321
# Узнать id: @userinfobot / @RawDataBot; подробности — docs/DEPLOY.md.

# SQLite (обязательно для 2.x): путь к файлу БД. По умолчанию ./data/vodovorot.db
# DATABASE_PATH=

# Legacy: JSON слотов «карта дня» из 1.x — один раз импортируется в БД при старте, если таблица слотов пуста.
# DAY_DRAW_STATE_PATH=

# IANA-часовой пояс для границы «суток» лимита «карта дня» и для расчёта времени подписки (по умолчанию UTC).
# Для аудитории UTC+3 можно задать, например: DAY_DRAW_TIMEZONE=Europe/Moscow
# DAY_DRAW_TIMEZONE=UTC

# Локальное время ежедневной автокарты (ЧЧ:ММ, 00:00–23:59) до первого выбора пользователем; неверное значение — как 09:00.
# DAY_PUSH_DEFAULT_HHMM=09:00

# Админы (полный доступ + флаг is_admin в БД): список user id, как у ALLOWED_TELEGRAM_USER_IDS.
# ADMIN_TELEGRAM_USER_IDS=

# OpenRouter Chat Completions (обязательно для толкований через ИИ).
# Ключ: https://openrouter.ai/keys — в проде только в .env на сервере, не в git.
OPENROUTER_API_KEY=
# Цепочка бесплатных моделей (:free) задана в src/openRouterModels.ts (последовательный fallback).
